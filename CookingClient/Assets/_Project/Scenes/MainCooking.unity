  m_text: "\u7279\u522B\u6F14\u51FA\n\u5E73\uFF01 \u9970\u6F14 \u7AE0\u9C7C\u732B\n\u56FE\u56FE
    \u9970\u6F14 \u9F3B\u560E\u56FE\n\u55DD\u513FDIGE \u9970\u6F14 \u793E\u79EF\u98DF\n\u6C89\u821F
    \u9970\u6F14 \u541F\u6E38\u8BD7\u4EBA\n59 \u9970\u6F14 \u5C0F\u8BF4\u5BB6\n\n\u6E38\u620F\u7B56\u5212\uFF1A\u6797\u5B50\u5927\u4E86\u4EC0\u4E48\u540E\u53A8\u90FD\u6709\n\n\u4E3B\u7B56\u5212\uFF1A\u5E73!\n\u4E3B\u7A0B\u5E8F\uFF1A\u56FE\u56FE\n\u6E38\u620F\u7F8E\u672F\uFF1A\u55DD\u513FDIGE\u300159\n\nUI\u8BBE\u8BA1\uFF1A\u55DD\u513FDIGE    
    \n\u4EBA\u7269\u8BBE\u8BA1\uFF1A59\n\u6587\u6848\u7B56\u5212\uFF1A59  \n\u7FFB\u8BD1\uFF1A\u5E73\uFF01\n\n\u97F3\u4E50\u8BBE\u8BA1\uFF1A\u6C89\u821F"
