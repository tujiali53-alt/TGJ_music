    textEn: 'Tonight: Status normal'
    color: '#FFFFFF'
  - id: log.buff_high
    textZh: "\u4ECA\u591C\uFF1A\u79FB\u901F\u63D0\u5347\uFF0C\u7167\u4EAE\u8303\u56F4\u589E\u52A0"
    textEn: 'Tonight: Movement speed increased, illumination range increased'
    color: '#E8C36A'
  - id: log.roll
