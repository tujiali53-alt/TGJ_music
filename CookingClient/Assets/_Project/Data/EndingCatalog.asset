  m_Script: {fileID: 11500000, guid: 30fa956d79137e74a9e298d5b14e8d6d, type: 3}
  m_Name: EndingCatalog
  m_EditorClassIdentifier: Cooking::Cooking.Data.EndingCatalog
  commonLines:
  - speaker: "\u4E3B\u89D2"
    textZh: "\u8FD9\u5C31\u662F\u672B\u65E5\u540E\u7684\u4E16\u754C\u5417\uFF1F\u603B\u611F\u89C9\u6709\u4E9B\u4E0D\u592A\u4E00\u6837\u3002"
    textEn: 
    expressionId: Main_Normal
    expression: {fileID: 21300000, guid: cfdf2882c7d3d1040bdea747af36b7ae, type: 3}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u4E3A\u4EC0\u4E48\u8FD9\u4E9B\u4E1C\u897F\u600E\u4E48\u4E5F\u5728\u8FD9\u91CC\uFF1F"
    textEn: 
    expressionId: 
    expression: {fileID: 0}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u8BF4\u8D77\u6765\uFF0C\u6211\u4E00\u76F4\u6CA1\u5F04\u6E05\u695A\u5B83\u4EEC\u7A76\u7ADF\u6709\u4EC0\u4E48\u4F5C\u7528\u3002"
    textEn: 
    expressionId: 
    expression: {fileID: 0}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u5982\u4ECA\u7EC8\u4E8E\u4E0D\u7528\u62C5\u5FC3\u660E\u5929\u5403\u4EC0\u4E48\uFF0C\u8BA9\u6211\u597D\u597D\u77A7\u77A7\u2026\u2026"
    textEn: 
    expressionId: 
    expression: {fileID: 0}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u3010Main_shocked\u3011\u3001\u7B56\u5212\u6848\u3001Bug\u53CD\u9988\u8868\u3001\u5267\u60C5\u811A\u672C\u3001\u8FD8\u6709\u97F3\u6548\u5408\u96C6\uFF1F"
    textEn: 
    expressionId: Main_Shocked
    expression: {fileID: 21300000, guid: e6589e813e571de449371da0961388b1, type: 3}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u7B49\u7B49\uFF01\u4E3A\u4EC0\u4E48\u8FDE\u6211\u6BCF\u5929\u4EC0\u4E48\u65F6\u5019\u51FA\u95E8\u3001\u9047\u5230\u4E86\u54EA\u4E9B\u4E8B\u90FD\u6709\uFF1F"
    textEn: 
    expressionId: Main_Pray
    expression: {fileID: 21300000, guid: 4923b551761e48244b270d507dcb11c2, type: 3}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u2026\u2026"
    textEn: 
    expressionId: Main_Pray
    expression: {fileID: 21300000, guid: 4923b551761e48244b270d507dcb11c2, type: 3}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u539F\u6765\u5982\u6B64\u3002"
    textEn: 
    expressionId: 
    expression: {fileID: 0}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u6240\u8C13\u7684\u4E16\u754C\u672B\u65E5\u6839\u672C\u4E0D\u662F\u4EC0\u4E48\u5929\u707E\u2026\u2026"
    textEn: 
    expressionId: 
    expression: {fileID: 0}
  - speaker: "\u4E3B\u89D2"
    textZh: "\u53EA\u662F\u4F60\u4EEC\u8FD9\u7FA4\u5BB6\u4F19\u7684\u622A\u6B62\u65E5\u5230\u4E86\u554A\uFF01\uFF01\uFF01"
    textEn: 
    expressionId: Main_Worry
    expression: {fileID: 21300000, guid: 5f47d63f54f417945b151124eea7898d, type: 3}
  endings:
  - id: ending_good
    priority: 100
    requireAllInBookDiaries: 1
    forbidAllInBookDiaries: 0
    requireAllNpcProps: 0
    forbidAllNpcProps: 0
    cg: {fileID: 21300000, guid: f3fbfbb32923cb24bb624fcd4ea7bb8e, type: 3}
    endingImageZh: {fileID: 21300000, guid: 7eac7446b1b79b546bcf7399e6596349, type: 3}
    endingImageEn: {fileID: 21300000, guid: 6d2fddef06ca41d439675f42d1d68a1a, type: 3}
    metaEndingImageZh: {fileID: 21300000, guid: 5ff8fe0578ee915488321f95911f7b9a, type: 3}
    metaEndingImageEn: {fileID: 21300000, guid: 27a30461cfac86841bfea05e92100658, type: 3}
    clickTextZh: "\u70B9\u51FB\u4EFB\u610F\u5904\u7EE7\u7EED"
    clickTextEn: 
    lines:
    - speaker: "\u4E3B\u89D2"
      textZh: "\u771F\u662F\u8352\u5510\u3002"
      textEn: 
      expressionId: Main_Worry
      expression: {fileID: 21300000, guid: 5f47d63f54f417945b151124eea7898d, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u6CA1\u60F3\u5230\uFF0C\u6839\u672C\u4E0D\u9700\u8981\u7B49\u4E0A\u767E\u5E74\u3001\u5343\u5E74\u3001\u4E07\u5E74\u3002"
      textEn: 
      expressionId: Main_Normal
      expression: {fileID: 21300000, guid: cfdf2882c7d3d1040bdea747af36b7ae, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u5C31\u5728\u8FD9\u4E2A\u4E16\u754C\u4E4B\u5916\uFF0C\u4FBF\u5DF2\u7ECF\u6709\u4EBA\u89C1\u8BC1\u4E86\u8FD9\u6BB5\u5FAE\u4E0D\u8DB3\u9053\u7684\u4EBA\u751F\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u4E8B\u5230\u5982\u4ECA\uFF0C\u56DE\u53BB\u4FEE\u6539\u65E5\u8BB0\u4E5F\u6BEB\u65E0\u610F\u4E49\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u6BD5\u7ADF\u6211\u53EA\u662F\u4E00\u4E2A\u88AB\u4F60\u4EEC\u521B\u9020\u51FA\u6765\u7684\u5012\u9709\u53A8\u5E08\u3002\u5373\u4FBF\u5982\u6B64\uFF0C\u6211\u4F9D\u65E7\u70ED\u7231\u7740\u6211\u7684\u4E8B\u4E1A\u3002"
      textEn: 
      expressionId: Main_Confidence
      expression: {fileID: 21300000, guid: 8b356976984a41c4cb994867d0a90a79, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u554A\u2014\u2014\u771F\u53EF\u60DC\uFF0C\u4E00\u70B9\u591A\u4F59\u7684\u65F6\u95F4\u90FD\u4E0D\u80AF\u7ED9\u6211\u3002"
      textEn: 
      expressionId: Main_Worry
      expression: {fileID: 21300000, guid: 5f47d63f54f417945b151124eea7898d, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u6211\u60F3\uFF0C\u4F60\u5E94\u8BE5\u4E5F\u770B\u89C1\u4E86\u5427\uFF1F"
      textEn: 
      expressionId: Main_Smile
      expression: {fileID: 21300000, guid: e94ae6311ee3a3b41af55d8f4e9e88fc, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u5373\u4F7F\u4E16\u754C\u7684\u4E00\u5207\u90FD\u65E9\u5DF2\u88AB\u5199\u4E0B\uFF0C\u81F3\u5C11\u5BF9\u6211\u800C\u8A00\uFF0C\u90A3\u4E9B\u7ECF\u5386\u5E76\u975E\u865A\u5047\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u5982\u679C\u4F60\u6709\u673A\u4F1A\u89C1\u5230\u90A3\u4E9B\u521B\u9020\u6211\u7684\u4EBA\uFF0C\u8BF7\u66FF\u6211\u544A\u8BC9\u90A3\u4E9B\u5BB6\u4F19\u2014\u2014"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u867D\u7136\u4F60\u4EEC\u53EA\u7ED9\u4E86\u6211\u77ED\u77ED\u4E03\u5929\uFF0C\u4F46\u4E5F\u7B97\u8FC7\u4E86\u4E00\u6BB5\u5FEB\u4E50\u7684\u65E5\u5B50\u3002"
      textEn: 
      expressionId: Main_Happy
      expression: {fileID: 21300000, guid: 0d9d4a104912594408a7937c4dd198fb, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8FD8\u6709\u4F60\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8C22\u8C22\u4F60\u966A\u6211\u8D70\u5B8C\u8FD9\u6BB5\u65C5\u7A0B\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8981\u662F\u8FD8\u6709\u4E0B\u6B21\u2026\u2026"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u81F3\u5C11\u7ED9\u6211\u51C6\u5907\u4E00\u53F0\u70E4\u7BB1\u554A\uFF01"
      textEn: 
      expressionId: Main_Worry
      expression: {fileID: 21300000, guid: 5f47d63f54f417945b151124eea7898d, type: 3}
  - id: ending_normal
    priority: 50
    requireAllInBookDiaries: 0
    forbidAllInBookDiaries: 1
    requireAllNpcProps: 0
    forbidAllNpcProps: 0
    cg: {fileID: 21300000, guid: d181836628ec6f040adf44f04eaa24bf, type: 3}
    endingImageZh: {fileID: 21300000, guid: 321becf89652f414983cbe3e558e04a2, type: 3}
    endingImageEn: {fileID: 21300000, guid: 3fd4b4592c1bce643a2a10762145053b, type: 3}
    metaEndingImageZh: {fileID: 21300000, guid: e84a9048bdbe1f946a4845788c773893, type: 3}
    metaEndingImageEn: {fileID: 21300000, guid: 316c04a776b58e84ba33295721e73ec5, type: 3}
    clickTextZh: "\u70B9\u51FB\u4EFB\u610F\u5904\u7EE7\u7EED"
    clickTextEn: 
    lines:
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8FD9\u4E48\u8BF4\u6765\uFF0C\u6211\u8FD9\u51E0\u5929\u7684\u4E00\u4E3E\u4E00\u52A8\u90FD\u88AB\u4F60\u770B\u4E86\u4E2A\u4E00\u6E05\u4E8C\u695A\uFF1F"
      textEn: 
      expressionId: Main_Worry
      expression: {fileID: 21300000, guid: 5f47d63f54f417945b151124eea7898d, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u771F\u662F\u89C1\u7B11\uFF0C\u6211\u672C\u6765\u8FD8\u4EE5\u4E3A\u80FD\u628A\u90A3\u4E9B\u89C1\u4E0D\u5F97\u4EBA\u7684\u8FC7\u5F80\u4E00\u8D77\u5E26\u8FDB\u575F\u5893\u91CC\u5462\u3002"
      textEn: 
      expressionId: Main_Forced
      expression: {fileID: 21300000, guid: ce9ac9c394da55944ac6c66c52904c1c, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u867D\u7136\u6309\u7167\u201C\u5267\u672C\u201D\u7684\u8BF4\u6CD5\uFF0C\u6211\u65E9\u5DF2\u7ECF\u6B7B\u8FC7\u4E00\u6B21\u4E86\u3002"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8FD9\u7B97\u4EC0\u4E48\uFF1F\u622A\u6B62\u65E5\u671F\u5230\u4E86\u6765\u4E0D\u53CA\u5F00\u53D1\u4E86\u5417\uFF1F"
      textEn: 
      expressionId: Main_Defeat
      expression: {fileID: 21300000, guid: a5532e74ddec65b4797fcd742d3cd65e, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u81F3\u4E8E\u90A3\u4E9B\u6CA1\u80FD\u5F97\u5230\u89E3\u7B54\u7684\u95EE\u9898\uFF0C\u5C31\u8BA9\u5B83\u4EEC\u968F\u98CE\u53BB\u5427\u3002"
      textEn: 
      expressionId: Main_Smile
      expression: {fileID: 21300000, guid: e94ae6311ee3a3b41af55d8f4e9e88fc, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u6BD5\u7ADF\u8981\u662F\u518D\u8BA9\u4ED6\u4EEC\u5199\u4E0B\u53BB\uFF0C\u6050\u6015\u5C31\u8981#\uFFE5@\uFFE5@%\u2014\u2014"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u3010\u4F60\u4EE5\u4E3A\u8FD9\u5C31\u662F\u7ED3\u675F\u4E86\u5417\uFF1F\u3011"
      textEn: 
      expressionId: Main_Shadow
      expression: {fileID: 21300000, guid: 9bd33ab1ce2ff074a8fd5090b0dd0b76, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u3010\u5475\u5475\uFF0C\u53EF\u4E0D\u8981\u5C0F\u77A7DDL\u7684\u529B\u91CF\u554A\uFF01\u3011"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u3010\u60F3\u529E\u6CD5\u96C6\u9F50\u5168\u90E8\u65E5\u8BB0\uFF0C\u89E3\u9501\u5B8C\u6574\u5267\u60C5\u5427\uFF01\u3011"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u5657\u54C8\u2026\u2026\uFF01\u521A\u521A\u90A3\u662F\u4EC0\u4E48\uFF01\uFF1F\u6211\u600E\u4E48\u4E0D\u80FD\u8BF4\u8BDD\u4E86\uFF1F"
      textEn: 
      expressionId: Main_Shocked
      expression: {fileID: 21300000, guid: e6589e813e571de449371da0961388b1, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u2026\u2026"
      textEn: 
      expressionId: Main_Normal
      expression: {fileID: 21300000, guid: cfdf2882c7d3d1040bdea747af36b7ae, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u554A\uFF0C\u4F60\u8981\u79BB\u5F00\u4E86\u5417\uFF1F"
      textEn: 
      expressionId: 
      expression: {fileID: 0}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u8C22\u8C22\u4F60\u966A\u6211\u5EA6\u8FC7\u8FD9\u4E03\u5929\uFF0C\u4E0D\u77E5\u9053\u6211\u7684\u6545\u4E8B\u662F\u5426\u5408\u4F60\u80C3\u53E3\u5462\uFF1F"
      textEn: 
      expressionId: Main_Smile
      expression: {fileID: 21300000, guid: e94ae6311ee3a3b41af55d8f4e9e88fc, type: 3}
    - speaker: "\u4E3B\u89D2"
      textZh: "\u518D\u89C1\uFF0C\u8BA9\u6211\u4EEC\u5728\u5B8C\u7F8E\u7684\u65F6\u95F4\u7EBF\u518D\u4F1A\u5427\uFF01"
      textEn: 
      expressionId: Main_Happy
      expression: {fileID: 21300000, guid: 0d9d4a104912594408a7937c4dd198fb, type: 3}
