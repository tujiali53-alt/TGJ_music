  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u4E00\u5BF9\uFF0C\u4E5F\u5C31\u662F\u4E24\u53EA\u94A2\u80CC\u517D\u592B\u5987\u4E3A\u5E7C\u5D3D\u7684\u629A\u517B\u65B9\u9488\u3001\u623F\u8D37\u548C\u5BB6\u52A1\u5206\u914D\u8D77\u4E86\u51B2\u7A81\u3002\u5B83\u4EEC\u671D\u5F7C\u6B64\u4F4E\u543C\uFF0C\u9CDE\u7247\u78B0\u649E\u6469\u64E6\u51FA\u706B\u82B1\uFF0C\u5728\u9ED1\u6697\u4E2D\u660E\u660E\u706D\u706D\u3002"
  - optionId: opt_beasts_mediate
    phase: 1
    order: 1
    text: "\u4F60\u5229\u7528\u81EA\u5DF1\u7075\u5DE7\u7684\u624B\u6307\uFF0C\u5E2E\u5B83\u4EEC\u89E3\u5F00\u4E86\u9EBB\u70E6\u6E90\u4E4B\u4E00\u2014\u2014\u6D1E\u7A74\u6DF1\u5904\u7EA0\u7ED3\u7684\u85E4\u8513\u3002\u94A2\u80CC\u517D\u4EEC\u611F\u8C22\u4E86\u4F60\uFF0C\u7136\u540E\u8FC5\u901F\u9677\u5165\u4E86\u4E0B\u4E00\u8F6E\u4E89\u5435\uFF0C\u63A5\u7740\u6F14\u53D8\u4E3A\u6597\u6BB4\u3002"
  - optionId: opt_beasts_mediate
    phase: 2
    order: 1
    text: "\u51E1\u4EBA\u4E0D\u5E94\u8BE5\u63D2\u624B\u6B64\u7C7B\u6218\u6597\uFF01\u4F60\u786E\u4FE1\u81EA\u5DF1\u5931\u53BB\u4E86\u4E0D\u5C0F\u5FC3\u88AB\u6CE2\u53CA\u7684\u8BB0\u5FC6\u7247\u6BB5\uFF0C\u8FD9\u662F\u4F60\u7684\u5927\u8111\u5728\u4FDD\u62A4\u4F60\uFF0C\u5927\u6982\u3002\u4F60\u7684\u4E0B\u8179\u706B\u8FA3\u8FA3\u5730\u75BC\u75DB\uFF0C\u808B\u9AA8\u4E5F\u65AD\u4E86\u51E0\u6839\u3002"
  - optionId: opt_beasts_watch
    phase: 1
    order: 1
    text: "\u4E16\u754C\u4E0A\u552F\u4E00\u6BD4\u94A2\u80CC\u517D\u7684\u5934\u9AA8\u66F4\u575A\u786C\u7684\u662F\u53E6\u4E00\u53EA\u94A2\u80CC\u517D\u7684\u5934\u9AA8\u3002\u8C01\u4E5F\u4E0D\u670D\u8F93\u7684\u75DB\u6BB4\u8BA9\u5B83\u4EEC\u53CC\u53CC\u6655\u5012\u5728\u5730\uFF0C\u8111\u95E8\u9686\u8D77\u9E21\u86CB\u5927\u7684\u80BF\u5305\u3002"
  - optionId: opt_beasts_side
    phase: 1
    order: 1
    text: "\u4F60\u575A\u5B9A\u5730\u9009\u62E9\u4E86\u5176\u4E2D\u4E00\u8FB9\u62BC\u5B9D\u3002\u6536\u5230\u4F60\u52A0\u6CB9\u52A9\u5A01\u7684\u94A2\u80CC\u517D\u5907\u53D7\u9F13\u821E\uFF0C\u4E00\u53E3\u6C14\u6380\u7FFB\u4E86\u5BF9\u65B9\uFF0C\u5F97\u610F\u6D0B\u6D0B\u5730\u770B\u7740\u914D\u5076\u56DB\u811A\u671D\u5929\u626D\u52A8\u7740\uFF0C\u8BD5\u56FE\u7FFB\u8EAB\u518D\u6218\u3002"
  - optionId: opt_beasts_side
    phase: 2
    order: 1
    text: "\u8FD9\u56DE\u4F60\u53EF\u8D4C\u9519\u4E86\u3002\u4F60\u6700\u4E0D\u5E0C\u671B\u770B\u89C1\u7684\u80DC\u8005\u4EF0\u5934\u957F\u5578\uFF0C\u76EE\u9732\u51F6\u5149\u5730\u8F6C\u5411\u4F60\u3002\u4E0D\u7528\u8BF4\uFF0C\u4F60\u4E3A\u4E86\u5C0F\u547D\u98DE\u4E00\u822C\u5730\u9003\u79BB\u4E86\u73B0\u573A\uFF0C\u8FDE\u8981\u6454\u4E00\u8DE4\u90FD\u5FD8\u4E86\u3002"
