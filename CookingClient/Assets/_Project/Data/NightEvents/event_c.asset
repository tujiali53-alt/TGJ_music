  introPortrait: {fileID: 21300000, guid: cfdf2882c7d3d1040bdea747af36b7ae, type: 3}
  options:
  - optionId: opt_c_1
    order: 1
    displayNameZh: "\u6572\u6572\u8717\u58F3"
    displayNameEn: Knock on the snail shell
    conditionType: 0
