  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u6708\u8272\u4E0B\uFF0C\u82A6\u82C7\u4E1B\uFF0C\u5F71\u5B50\u8F7B\u8F7B\u6643\u52A8\uFF0C\u6E05\u6C60\u8D77\u6D9F\u6F2A\u3002\u4F60\u7948\u7977\u8FD9\u9635\u5FAE\u98CE\u4E0D\u4F1A\u5413\u8D70\u4F60\u7684\u9C7C\u513F\u3002\u7A81\u7136\uFF01\u7EBF\u7EF7\u76F4\u4E86\uFF0C\u5DE8\u529B\u4ECE\u5F2F\u9C7C\u7AFF\u7684\u90A3\u5934\u4F20\u6765\u3002\u5927\u7684\u8981\u6765\u4E86\uFF01"
  - optionId: opt_fishing_cast
    phase: 1
    order: 1
    text: "\u4F60\u76F4\u8D77\u8170\u594B\u529B\uFF0C\u8BD5\u56FE\u5C06\u5927\u9C7C\u62C9\u79BB\u6C34\u9762\uFF0C\u6D51\u8EAB\u7684\u808C\u8089\u597D\u50CF\u4E5F\u8981\u8DDF\u7740\u62C9\u65AD\u3002\u4F46\u8FD9\u4E00\u5207\u90FD\u662F\u503C\u5F97\u7684\uFF0C\u77A7\u77A7\u90A3\u91D1\u9EC4\u7684\u9CDE\u7247\u5427\uFF0C\u5E95\u4E0B\u4E00\u5B9A\u5367\u7740\u9C9C\u7F8E\u7684\u9C7C\u8089\u3002"
  - optionId: opt_fishing_cast
    phase: 2
    order: 1
    text: "\u9C7C\u4E0D\u8D39\u5439\u7070\u4E4B\u529B\u5C31\u626F\u65AD\u4E86\u7EBF\uFF0C\u8FD8\u6311\u8845\u4F3C\u7684\u8DF3\u51FA\u6C34\u9762\uFF0C\u987A\u4FBF\u626C\u8D77\u5C3E\u5DF4\u62CD\u4E86\u4F60\u4E00\u8138\u6D6A\u82B1\u3002\u4F60\u6296\u843D\u6C34\u73E0\uFF0C\u62E7\u5E72\u8863\u670D\uFF0C\u53D1\u8A93\u4E00\u5B9A\u8981\u62A5\u8FD9\u4EC7\u3002"
  - optionId: opt_fishing_wait
    phase: 1
    order: 1
    text: "\u4F60\u6C89\u4F4F\u6C14\uFF0C\u62C9\u5F00\u67B6\u52BF\u4E0E\u9C7C\u5468\u65CB\u3002\u5B83\u7684\u4F53\u529B\u7EC8\u7A76\u662F\u6709\u9650\u7684\uFF0C\u5728\u4E16\u7EAA\u822C\u6F2B\u957F\u7684\u535A\u5F08\u540E\uFF0C\u4F60\u548C\u9C7C\u8FBE\u6210\u4E86\u67D0\u79CD\u5BBF\u654C\u5F0F\u7684\u53CB\u8C0A\u3002\u5B89\u606F\u5427\uFF0C\u631A\u53CB\uFF0C\u6211\u4F1A\u597D\u597D\u628A\u4F60\u5B89\u846C\u5728\u8179\u4E2D\u3002"
