  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u77F3\u5934\u5728\u6708\u5149\u4E0B\u6709\u7740\u6444\u4EBA\u5FC3\u9B44\u7684\u7F8E\uFF0C\u90A3\u62B9\u767D\u8272\u6D53\u5F97\u8FD1\u4E4E\u4E8E\u9C9C\u8840\u3002\u4E5F\u8BB8\u5B83\u672C\u5C31\u662F\u6708\u5CA9\u7684\u4E00\u90E8\u5206\uFF0C\u6240\u4EE5\u624D\u5982\u6B64\u5723\u6D01\u3002\u4F60\u53D1\u89C9\u81EA\u5DF1\u7684\u53CC\u811A\u6B63\u671D\u5B83\u8FC8\u52A8\u3002"
  - optionId: opt_moon_look
    phase: 1
    order: 1
    text: "\u77F3\u5934\u8FB9\uFF0C\u4E00\u6EE9\u6C34\u5012\u6620\u7740\u6708\u4EAE\u3002\u6C34\u6D3C\u6B63\u6025\u5267\u7F29\u5C0F\uFF0C\u4F60\u610F\u8BC6\u5230\u8FD9\u662F\u90A3\u5757\u77F3\u5934\u5728\u5438\u6C34\u3002\u77F3\u5934\u7684\u989C\u8272\u663E\u5F97\u8D8A\u53D1\u4E30\u76C8\u4E86\uFF0C\u800C\u6C34\u4E2D\u7684\u5C0F\u9C7C\u5C0F\u867E\u7EB7\u7EB7\u5728\u5E72\u6E34\u4E2D\u8E66\u8D77\u6765\u3002"
  - optionId: opt_moon_touch
    phase: 1
    order: 1
    text: "\u4F60\u628A\u81EA\u5DF1\u7684\u53CC\u624B\u6309\u5728\u77F3\u5934\u7684\u8868\u9762\u4E0A\uFF0C\u5B83\u6BD4\u4F60\u60F3\u7684\u8FD8\u8981\u5149\u6ED1\u3002\u968F\u7740\u624B\u90E8\u7684\u52A8\u4F5C\uFF0C\u8111\u6D77\u4E2D\u7ADF\u4E5F\u54CD\u8D77\u97F3\u4E50\u58F0\u3002\u4F60\u98D8\u98D8\u6B32\u4ED9\uFF0C\u611F\u5230\u81EA\u5DF1\u65E0\u6240\u4E0D\u80FD\uFF0C\u53EF\u4EE5\u521B\u9020\u4E00\u5207\uFF0C\u751A\u81F3\u4E00\u6839\u9EC4\u74DC\u3002"
