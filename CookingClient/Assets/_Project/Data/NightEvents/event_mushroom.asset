  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u884C\u8D70\u65F6\uFF0C\u4F60\u7684\u811A\u5C16\u4F3C\u4E4E\u8E22\u5230\u4E86\u4EC0\u4E48\u67D4\u8F6F\u7684\u4E1C\u897F\u3002\u501F\u7740\u5FAE\u5F31\u7684\u5149\u4EAE\u67E5\u770B\uFF0C\u539F\u6765\u662F\u8611\u83C7\u7684\u83CC\u76D6\u3002\u51FA\u4E4E\u610F\u6599\u7684\u662F\uFF0C\u5B83\u7684\u6839\u987B\u4F3C\u4E4E\u6DF1\u6DF1\u624E\u5165\u4E86\u6CE5\u571F\uFF0C\u4E0D\u613F\u8F7B\u6613\u79BB\u5F00\u3002"
  - optionId: opt_mushroom_pull
    phase: 1
    order: 1
    text: "\u4F60\u624B\u811A\u5E76\u7528\uFF0C\u7D27\u7D27\u73AF\u4F4F\u8611\u83C7\uFF0C\u4EFF\u4F5B\u5728\u4F7F\u7528\u4E00\u79CD\u9488\u5BF9\u83CC\u7C7B\u7684\u67D4\u672F\u3002\u6CE5\u571F\u7684\u9897\u7C92\u5361\u8FDB\u4E86\u4F60\u7684\u6307\u7532\u7F1D\uFF0C\u968F\u540E\u5657\u901A\u4E00\u58F0\uFF0C\u4F60\u548C\u8611\u83C7\u4E00\u8D77\u8EBA\u5012\u5728\u5730\u3002"
  - optionId: opt_mushroom_pull
    phase: 2
    order: 1
    text: "\u8611\u83C7\u4E0E\u5730\u9762\u4E4B\u95F4\u96BE\u9053\u53EA\u6709\u771F\u7A7A\u5417\uFF1F\u4F60\u65E0\u6CD5\u4E0E\u8FD9\u80A1\u5DE8\u5927\u7684\u5438\u529B\u6297\u8861\uFF0C\u6447\u6447\u5934\u9057\u61BE\u79BB\u573A\u3002\u53EA\u662F\u53EF\u60DC\u4E86\u4F60\u597D\u4E0D\u5BB9\u6613\u6D17\u5E72\u51C0\u7684\u88E4\u5B50\uFF0C\u8FD9\u4F1A\u819D\u76D6\u4E0A\u90FD\u662F\u6CE5\u5DF4\u3002"
  - optionId: opt_mushroom_pinch
    phase: 1
    order: 1
    text: "\u957F\u957F\u7684\u6307\u7532\u7EC8\u4E8E\u6709\u4E86\u7528\u6B66\u4E4B\u5730\uFF0C\u4F60\u7528\u6307\u5C16\u786E\u8BA4\u7740\u89E6\u611F\u5256\u5F00\u4F1E\u76D6\u3002\u4F60\u6210\u529F\u5272\u4E0B\u4E00\u8F6E\u8611\u83C7\u7684\u6E05\u9999\u4F5C\u4E3A\u4ECA\u591C\u7684\u6536\u83B7\u3002\u8611\u83C7\u67C4\u7559\u5728\u539F\u5730\uFF0C\u50CF\u65B0\u4F10\u7684\u6811\u6869\u3002"
