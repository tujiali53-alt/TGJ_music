  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u9759\u9759\u7684\u7891\u77F3\u662F\u51B0\u51B7\u7684\uFF0C\u6B7B\u53BB\u7684\u4EBA\u4EEC\u6C38\u7720\u4E8E\u6B64\u3002"
  - optionId: opt_grave_mourn
    phase: 1
    order: 1
    text: "\u4E00\u80A1\u51B7\u610F\u63A0\u8FC7\u4E86\u540E\u8116\u5B50\uFF0C\u4F60\u4E0B\u610F\u8BC6\u5730\u8038\u80A9\u56DE\u5934\uFF0C\u539F\u6765\u53EA\u662F\u98CE\u4ECE\u690D\u7269\u7684\u7F1D\u9699\u4E2D\u5439\u8FC7\u6765\u3002"
  - optionId: opt_grave_flower
    phase: 1
    order: 1
    text: "\u4F60\u628A\u7626\u5F31\u7684\u82B1\u5708\u52A0\u5195\u4E8E\u5893\u7891\u3002\u6458\u82B1\u65F6\uFF0C\u4E00\u4E9B\u5F62\u72B6\u7279\u6B8A\u7684\u8349\u53F6\u5F15\u8D77\u4E86\u4F60\u7684\u6CE8\u610F\u3002\u4F60\u7AB8\u7AB8\u7AA3\u7AA3\u5730\u62E8\u5F00\u5B83\u4EEC\uFF0C\u4E00\u53EA\u5C0F\u9F20\u4ED3\u7687\u9003\u7A9C\uFF0C\u628A\u81EA\u5DF1\u7684\u5E93\u5B58\u62F1\u624B\u76F8\u8BA9\u3002"
  - optionId: opt_grave_mourn
    phase: 1
    order: 2
    text: "\u2026\u2026\u4E0D\u8FC7\u5B83\u4EEC\u539F\u672C\u5C31\u5728\u8FD9\u91CC\u5417\uFF1F"
