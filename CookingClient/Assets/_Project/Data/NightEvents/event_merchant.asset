  lines:
  - optionId: 
    phase: 0
    order: 1
    text: "\u8FD9\u4E2A\u5546\u4EBA\u4E0D\u58F0\u4E0D\u54CD\u4ECE\u9634\u5F71\u91CC\u51FA\u73B0\uFF0C\u628A\u4F60\u5413\u4E86\u4E00\u8DF3\u3002\u201C\u6211\u8FD9\u6709\u597D\u4EA4\u6613\uFF01\u201D\u4ED6\u8BF1\u60D1\u5730\u5636\u5636\u9053\u3002\u4F60\u76EF\u7740\u90A3\u53CC\u86C7\u822C\u7684\u773C\u7738\uFF0C\u610F\u8BC6\u5230\u81EA\u5DF1\u8981\u505A\u51FA\u9009\u62E9\u3002"
  - optionId: opt_merchant_trade
    phase: 1
    order: 1
    text: "\u201C\u597D\u5B69\u5B50\u2026\u2026\u201D\u5546\u4EBA\u5583\u5583\u81EA\u8BED\u5730\u629A\u6478\u7740\u4F60\u4EA4\u7ED9\u4ED6\u7684\u8D27\u7269\uFF0C\u8FD9\u8BE1\u5F02\u7684\u4E00\u5E55\u53EB\u4EBA\u4E0D\u5BD2\u800C\u6817\u3002\u4ED6\u4E00\u526F\u6025\u4E8E\u6253\u53D1\u8D70\u4F60\u7684\u6837\u5B50\uFF0C\u786C\u662F\u585E\u7ED9\u4F60\u4E00\u888B\u6C89\u7538\u7538\u7684\u8089\u5757\u3002"
  - optionId: opt_merchant_trade
    phase: 2
    order: 1
    text: "\u5546\u4EBA\u7ED9\u4E86\u4F60\u4E00\u4E9B\u91D1\u5E01\u3002\u4E0D\u8FC7\u94B1\u771F\u7684\u6709\u7528\u5417\uFF1F\u4EFF\u4F5B\u8981\u5370\u8BC1\u4F60\u7684\u60F3\u6CD5\uFF0C\u91D1\u5E01\u4EEC\u5728\u76EE\u5149\u4E2D\u5316\u6210\u7C89\u672B\uFF0C\u968F\u98CE\u98D8\u6563\u4E86\u3002\u4F60\u610F\u8BC6\u5230\u81EA\u5DF1\u7684\u53D7\u9A97\uFF0C\u7136\u800C\u52A0\u5BB3\u8005\u65E9\u5DF2\u8D70\u8FDC\u3002"
  - optionId: opt_merchant_leave
    phase: 1
    order: 1
    text: "\u4F60\u4E0D\u592A\u4E50\u610F\u548C\u4ED6\u505A\u4EA4\u6613\uFF0C\u5546\u4EBA\u4E5F\u6CA1\u591A\u8BF4\u4EC0\u4E48\u3002\u6BD4\u8D77\u4EBA\u7C7B\uFF0C\u4F60\u66F4\u613F\u610F\u76F8\u4FE1\u5927\u5730\u7684\u6069\u8D50\u2014\u2014\u64AD\u79CD\u5E26\u6765\u6536\u83B7\u3002\u4F60\u57CB\u4E0B\u8C37\u7269\uFF0C\u7136\u540E\u6398\u8D77\u5730\u4E0B\u4E30\u6536\u7684\u679C\u5B9E\u3002"
